# IMPORTANTE: Next.js expande variables $VAR dentro de los .env, así que los signos $
# del hash de bcrypt hay que escaparlos como \$ o el hash queda corrompido.
# Generar con: node scripts/set-admin-password.mjs "tu-nueva-clave"
ADMIN_PASSWORD_HASH=\$2b\$12\$...

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
